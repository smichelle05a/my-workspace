{
  "scripts": {
    "build": "npm run build:ts && npm run css:build",
    "build:ts": "tsc",
    "watch": "concurrently \"npm run watch:ts\" \"npm run css:watch\"",
    "watch:ts": "tsc --watch",
    "css:build": "tailwindcss -i ./styles/input.css -o ./styles/output.css",
    "css:watch": "tailwindcss -i ./styles/input.css -o ./styles/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.4.0"
  }
}
